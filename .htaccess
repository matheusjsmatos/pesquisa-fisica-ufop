# Portal de pesquisa DEFIS — configuração Apache (Hestia usa nginx + apache por padrão)
Options -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/plain image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
</IfModule>
<FilesMatch "\.(py|ps1|config|list|xlsx|ods|zip)$">
  Require all denied
</FilesMatch>
